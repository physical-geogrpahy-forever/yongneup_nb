+def _biome4_daily(mly: np.ndarray) -> np.ndarray:
+    """BIOME4 v4.2b2 ``daily`` 서브루틴을 그대로 옮긴 것(단정밀도, 1-based 일)."""
+    mly = np.asarray(mly, dtype=np.float32)
+    dly = np.zeros((366,) + mly.shape[1:], dtype=np.float32)  # index 1..365 사용
+    vinc = (mly[0] - mly[11]) / np.float32(31.0)
+    dly[350] = mly[11]
+    for d in range(351, 366):
+        dly[d] = dly[d - 1] + vinc
+    dly[1] = dly[365] + vinc
+    for d in range(2, 16):
+        dly[d] = dly[d - 1] + vinc
+    for im in range(11):
+        a, b = _B4_MIDDAY[im], _B4_MIDDAY[im + 1]
+        vinc = (mly[im + 1] - mly[im]) / np.float32(b - a)
+        dly[a] = mly[im]
+        for d in range(a + 1, b):
+            dly[d] = dly[d - 1] + vinc
+    return dly[1:]
+
+
+def biome4_liquid_water_monthly(temp_monthly_C: np.ndarray, prec_monthly_mm: np.ndarray) -> np.ndarray:
+    """BIOME4 v4.2b2 ``snow`` 서브루틴의 dprec+dmelt를 달력월로 합한 액체수(mm/month).
+
+    snowpack=0에서 시작해 같은 365일 기후를 두 번 돌리고, 두 번째 해의 값을 쓴다.
+    tsnow=-1 C, km=0.7 mm/(C day). 원 코드와 같은 단정밀도 연산 순서를 따른다.
+    """
+    t = np.asarray(temp_monthly_C, dtype=np.float32)
+    p = np.asarray(prec_monthly_mm, dtype=np.float32)
+    dtemp = _biome4_daily(t)
+    dprecin = _biome4_daily(p)
+    tsnow = np.float32(-1.0)
+    km = np.float32(0.7)
+    div = np.float32(365.0) / np.float32(12.0)
+    pack = np.zeros(t.shape[1:], dtype=np.float32)
+    liquid = np.zeros((365,) + t.shape[1:], dtype=np.float32)
+    for _it in range(2):
+        for d in range(365):
+            drain = dprecin[d] / div
+            cold = dtemp[d] < tsnow
+            newsnow = np.where(cold, drain, np.float32(0.0)).astype(np.float32)
+            melt = np.where(cold, np.float32(0.0), km * (dtemp[d] - tsnow)).astype(np.float32)
+            melt = np.where(melt > pack, pack, melt).astype(np.float32)
+            pack = (pack + newsnow - melt).astype(np.float32)
+            liquid[d] = (drain - newsnow) + melt
+    out = np.zeros((12,) + t.shape[1:], dtype="float64")
+    s = 0
+    for m, n in enumerate(_B4_DIM):
+        out[m] = liquid[s:s + n].astype("float64").sum(axis=0)
+        s += n
+    return out
+
